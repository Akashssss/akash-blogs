# ========================================================
# Enterprise MERN Blog Engine v2 - Environment Configuration
# ========================================================

# --- SERVER & SECURITY ---
PORT=3000
NODE_ENV=development
SERVER_DOMAIN=http://localhost:3000
CORS_ORIGIN=http://localhost:5173
SECRET_ACCESS_KEY=9ce7914468ba9821751d81c9e2c2199c78782c8691bcb596939fcaa1950dee3c

# --- DATABASE ---
DB_CONNECTION=mongodb+srv://thedev:<callmedev43457@cluster0.mhbi2jv.mongodb.net/?appName=Cluster0

# --- STORAGE DRIVER CONFIGURATION ---
# Primary storage driver to use: google_drive | backblaze | imagekit | cloudinary | local
STORAGE_DRIVER=google_drive

# Cloudinary activation flag: set to false to keep credentials ready without uploading to Cloudinary
USE_CLOUDINARY=false

# ========================================================
# 1. GOOGLE DRIVE (Primary Free Tier Choice - 15GB Free)
# ========================================================
# Paste Google Drive Folder ID from folder URL: https://drive.google.com/drive/folders/{FOLDER_ID}
GOOGLE_DRIVE_FOLDER_ID=

# Option A: Google Cloud Service Account (Recommended for production servers)
# 1. Go to Google Cloud Console -> IAM & Admin -> Service Accounts
# 2. Create service account, create JSON key, and share Drive folder with service account email
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"

# Option B: Google OAuth2 Refresh Token (For personal accounts)
# GOOGLE_CLIENT_ID=your_client_id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=your_client_secret
# GOOGLE_REFRESH_TOKEN=your_refresh_token
# GOOGLE_REDIRECT_URI=https://developers.google.com/oauthplayground

# ========================================================
# 2. BACKBLAZE B2 STORAGE (S3 Compatible - 10GB Free Tier)
# ========================================================
# B2_KEY_ID=your_backblaze_application_key_id
# B2_APP_KEY=your_backblaze_application_key
# B2_BUCKET_NAME=your-bucket-name
# B2_ENDPOINT=https://s3.us-west-004.backblazeb2.com
# B2_BUCKET_REGION=us-west-004
# B2_CDN_URL=https://your-custom-cdn.com

# ========================================================
# 3. IMAGEKIT.IO (20GB Bandwidth/mo Free CDN & Image Processing)
# ========================================================
# IMAGEKIT_PUBLIC_KEY=your_imagekit_public_key
# IMAGEKIT_PRIVATE_KEY=your_imagekit_private_key
# IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_id

# ========================================================
# 4. CLOUDINARY (Kept configured, dormant when USE_CLOUDINARY=false)
# ========================================================
CLOUDINARY_CLOUD_NAME=drubp1spc
CLOUDINARY_API_KEY=619216295898486
